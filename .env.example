# ============================================================================
# AARANYA SPICES — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your project credentials.
# If left empty, the app runs in Local Hybrid Mode using persisted local storage.
# ============================================================================

# 1. Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Razorpay Configuration (Frontend Public Key)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# 3. Admin Dashboard Passcode (Optional — default in dev: AARANYA2026)
VITE_ADMIN_PASSCODE=AARANYA2026

# ============================================================================
# SUPABASE EDGE FUNCTION SECRETS (Set via `supabase secrets set ...`)
# Do NOT prefix server secrets with VITE_
# ============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# SHIPROCKET_EMAIL=logistics@aaranyaspices.com
# SHIPROCKET_PASSWORD=your_shiprocket_api_password
